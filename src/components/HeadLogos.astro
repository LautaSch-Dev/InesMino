---
import icon96px from "../assets/logos/favicon-96x96.png?url";
import iconSVG from "../assets/logos/favicon.svg?url";
import iconICO from "../assets/logos/favicon.ico?url";
import icon180px from "../assets/logos/apple-touch-icon.png?url";
import siteManifest from "../assets/logos/site.webmanifest?url";
---

<link rel="icon" type="image/png" href={icon96px} sizes="96x96" />
<link rel="icon" type="image/svg+xml" href={iconSVG} />
<link rel="shortcut icon" href={iconICO} />
<link rel="apple-touch-icon" sizes="180x180" href={icon180px} />
<meta name="apple-mobile-web-app-title" content="INÉS MIÑO" />
<link rel="manifest" href={siteManifest} />
